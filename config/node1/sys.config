%% =============================================================================
%% sys.config for the `node1` demo release.
%%
%% Three nodes (node1/node2/node3) form a closed disterl cluster. They
%% differ only in `vm.args` (`-name`). The `bondy_db_demo` app env below
%% is identical across nodes — `bondy_db_demo_cluster` derives this
%% node's data dir (`<data_dir>/<node>`) and its peer list (`nodes`
%% minus self) at boot.
%% =============================================================================
[
    {bondy_db_demo, [
        {db_name, demo},
        %% Three sharded tables, each backed by a different CRDT fold:
        %%   users    — LWW register  (last-writer-wins single value)
        %%   counters — PN-Counter    (converging integer counter)
        %%   tags     — G-Set         (grow-only set, union-converging)
        {tables, [
            {users,    lww_register},
            {counters, pn_counter},
            {tags,     g_set}
        ]},
        {shard_count, 8},
        {data_dir, "/tmp/bondy_db_demo"},
        {nodes, ['node1@127.0.0.1', 'node2@127.0.0.1', 'node3@127.0.0.1']}
    ]},

    {bondy_mst, [
        %% Periodic pull-sync between peers. 250ms is snappy enough to
        %% watch convergence interactively; call
        %% `bondy_db_demo:sync_now()` to push immediately.
        {sync_scheduler, true},
        {sync_interval_ms, 250}
    ]},

    {kernel, [
        {logger_level, notice},
        {logger, [
            {handler, default, logger_std_h,
                #{formatter => {logger_formatter, #{
                    template => [
                        time, " ", level, " ", file, ":", line,
                        " ", msg, "\n"
                    ]
                }}}}
        ]}
    ]}
].
