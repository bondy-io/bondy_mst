%% =============================================================================
%% sys.config for the `node3` demo release.
%%
%% Identical to config/node1/sys.config — the three nodes share the
%% same app env and differ only in `vm.args` (`-name`).
%% `bondy_db_demo_cluster` derives this node's data dir
%% (`<data_dir>/<node>`) and peer list (`nodes` minus self) at boot.
%% =============================================================================
[
    {bondy_db_demo, [
        {db_name, demo},
        {tables, [
            {users,    lww_register},
            {counters, pn_counter},
            {tags,     g_set}
        ]},
        {shard_count, 8},
        {data_dir, "/tmp/bondy_db_demo"},
        {nodes, ['node1@127.0.0.1', 'node2@127.0.0.1', 'node3@127.0.0.1']}
    ]},

    {bondy_mst, [
        {sync_scheduler, true},
        {sync_interval_ms, 250}
    ]},

    {kernel, [
        {logger_level, notice},
        {logger, [
            {handler, default, logger_std_h,
                #{formatter => {logger_formatter, #{
                    template => [
                        time, " ", level, " ", file, ":", line,
                        " ", msg, "\n"
                    ]
                }}}}
        ]}
    ]}
].
