{minimum_otp_vsn, "R26"}.
{erl_opts, [
    debug_info
]}.

%% Single-app project: the root IS the `bondy_mst` library. The
%% Jepsen-facing OTP wrapper (HTTP shim + cluster wiring) is a
%% sibling rebar3 project at `jepsen/bondy_mst_jepsen/` that depends
%% on this lib via a `{path, ...}` dep. It is NOT pulled into the
%% lib's build.
{project_app_dirs, ["."]}.

{project_plugins, [
    rebar3_proper,
    rebar3_ex_doc,
    rebar3_hex,
    {erlfmt, "1.7.0"}
]}.


{deps, [
    {app_config,
        {git, "https://github.com/leapsight/app_config.git",
            {branch, "1.1.2"}
        }
    },
    {memory,
        {git, "https://github.com/Leapsight/memory.git",
            {branch, "master"}
        }
    },
    {key_value,
        {git, "https://github.com/leapsight/key_value.git",
            {tag, "1.1.1"}
        }
    },
    resulto,
    {bloomfi,
        {git, "https://github.com/Leapsight/bloomfi.git",
            {tag, "1.1.0"}
        }
    },
    %% rocksdb,
    {leveled,
        {git, "https://github.com/OpenRiak/leveled.git",
            {branch, "openriak-4.0"}
        }
    },
    telemetry
]}.




%% =============================================================================
%% RELX
%% =============================================================================



{relx, [
    {release, {bondy_mst, "0.4.0"}, [
        %% Erlang
        compiler,
        crypto,
        debugger,
        inets,
        kernel,
        os_mon,
        runtime_tools,
        sasl,
        stdlib,
        tools,
        %% Third-parties
        app_config,
        utils,
        resulto,
        memory,
        %% rocksdb,
        bloomfi,
        leveled,
        bondy_mst
    ]},
    {dev_mode, false},
    {include_src, false},
    {include_erts, true},
    {extended_start_script, true}
]}.

{profiles, [
    {test, [
        {relx, [
            {release, {bondy_mst, "0.4.0"}, [
                %% Erlang
                compiler,
                crypto,
                debugger,
                inets,
                kernel,
                os_mon,
                runtime_tools,
                sasl,
                stdlib,
                tools,
                %% Third-parties
                app_config,
                utils,
                resulto,
                memory,
                bloomfi,
                leveled,
                bondy_mst,
                %% test additions
                rocksdb
            ]},
            {dev_mode, false},
            {include_src, false},
            {include_erts, true},
            {extended_start_script, true}
        ]},
        {deps, [
            meck,
            proper,
            {types, "0.1.8"}
            %% leveled is in the default profile (see above) — no
            %% test-profile override needed since 2026-05-20 when the
            %% leveled-backed projection store + topologies were
            %% promoted into production code.
        ]},
        {erl_opts, [nowarn_export_all]},
        {dist_node, [{name, 'ct@127.0.0.1'}]}
    ]},
    %% `bench` profile — used by `bench/` (Elixir/Mix) to compile
    %% bondy_mst with extra backends the bench wants to compare.
    {bench, [
        {erl_opts, [nowarn_export_all]}
    ]}
]}.

{shell, [
  {config, "config/sys.config"},
  {apps, [bondy_mst]}
]}.


{erlfmt, [
    write,
    {print_width, 80},
    {exclude_files, []},
    {files, "{src,include,test,examples}/*.{hrl,erl}"}
]}.


%% =============================================================================
%% CODE QUALITY
%% =============================================================================


{cover_enabled, true}.
{cover_opts, [verbose]}.
{cover_export_enabled, true}.

{covertool, [
    {coverdata_files, ["ct.coverdata"]}
]}.

{eunit_opts, [
    verbose
    %% {report, {eunit_surefire, [{dir,"."}]}}
]}.

{ct_opts, [
    {sys_config, "config/sys.config"}
]}.

{proper_opts, [
    {numtests, 300}
]}.




%% =============================================================================
%% DOCS
%% =============================================================================


{hex, [
    {doc, #{provider => ex_doc}}
]}.


{ex_doc, [
    {name, "bondy_mst"},
    {source_url, <<"https://github.com/bondy-io/bondy_mst">>},
    {extras, [
        <<"README.md">>,
        <<"doc_extras/cheatsheet.cheatmd">>,
        <<"LICENSE">>,
        <<"CHANGELOG.md">>,
        <<"CODE_OF_CONDUCT.md">>
    ]},
    {main, <<"README.md">>},
    {api_reference, true}
]}.


