%% =============================================================================
%% Standalone rebar3 project. This is the Jepsen-facing OTP wrapper
%% (HTTP shim + 3-node disterl cluster wiring) consumed by the Clojure
%% Jepsen test under `../jepsen.bondymst/`.
%%
%% It depends on `bondy_mst` via a rebar3 path dependency so it is
%% NOT part of the lib's umbrella — `rebar3 compile` at the repository
%% root never pulls cowboy, jsx, or this app's source into the lib's
%% build. The release is built by running rebar3 inside this directory
%% (see `../../Makefile`: `rel-jepsen`).
%% =============================================================================

{minimum_otp_vsn, "R26"}.

{erl_opts, [
    debug_info
]}.

{deps, [
    %% Local dep override: `_checkouts/bondy_mst` is a symlink to the
    %% repository root (../../). rebar3 sees the checkout and uses
    %% it in preference to this git URL, which is only a fallback for
    %% an off-tree clone of this project alone. Local edits to the lib
    %% flow through the symlink immediately — no re-fetch needed.
    {bondy_mst, {git, "https://github.com/bondy-io/bondy_mst.git",
                 {branch, "develop"}}},
    {cowboy, "2.13.0"},
    {jsx, "3.1.0"}
]}.

{relx, [
    {release, {bondy_mst_jepsen_release, "0.4.0"}, [
        compiler,
        crypto,
        inets,
        kernel,
        os_mon,
        runtime_tools,
        sasl,
        stdlib,
        tools,
        app_config,
        utils,
        resulto,
        memory,
        bloomfi,
        leveled,
        telemetry,
        cowlib,
        ranch,
        cowboy,
        jsx,
        bondy_mst,
        bondy_mst_jepsen
    ]},
    {dev_mode, false},
    {include_src, false},
    {include_erts, true},
    {extended_start_script, true},
    {sys_config, "config/sys.config"},
    {vm_args, "config/vm.args"}
]}.

{profiles, [
    {test, [
        {erl_opts, [nowarn_export_all]}
    ]}
]}.
