# Used by the bench/fly/ Fly.io substrate (and any future container
# build). Patterns are relative to the repo root, which is the build
# context. See `bench/fly/Dockerfile` + `bench/fly/fly.toml`.

# Build artefacts — rebuilt inside the image; volume re-binds the
# real ones at boot time.
#
# NOTE: bench/lib/ is SOURCE (the `Bench` support module used by
# every bench script), not an artefact. Must NOT be excluded.
_build/
bench/_build/
bench/_output/
bench/deps/

# Test artefacts — never want in the image.
/tmp/
*.dump
erl_crash.dump

# Editor / OS noise.
.DS_Store
.idea/
.vscode/
*.swp

# VCS — kept out so the image doesn't carry the full history.
.git/
.gitignore

# Workspace-only.
.claude/
_design/

# The Fly artefacts themselves — circular reference avoided.
bench/fly/_build/
